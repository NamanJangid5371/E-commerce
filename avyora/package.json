{
  "name": "avyora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n store,admin -c cyan,magenta \"next dev --port 3000\" \"cross-env AVYORA_APP=admin NEXT_PUBLIC_AVYORA_APP=admin next dev --port 3001\"",
    "dev:store": "next dev --port 3000",
    "dev:admin": "cross-env AVYORA_APP=admin NEXT_PUBLIC_AVYORA_APP=admin next dev --port 3001",
    "dev:logistics": "cross-env AVYORA_APP=logistics NEXT_PUBLIC_AVYORA_APP=logistics NEXT_PUBLIC_LOGISTICS_ORIGIN=http://localhost:3002 next dev --port 3002",
    "dev:all": "concurrently -n store,admin,logistics -c cyan,magenta,yellow \"next dev --port 3000\" \"cross-env AVYORA_APP=admin NEXT_PUBLIC_AVYORA_APP=admin next dev --port 3001\" \"cross-env AVYORA_APP=logistics NEXT_PUBLIC_AVYORA_APP=logistics NEXT_PUBLIC_LOGISTICS_ORIGIN=http://localhost:3002 next dev --port 3002\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate || exit 0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:migrate-json": "tsx scripts/migrate-from-json.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sot": "vitest run src/server/sot/transactional.test.ts",
    "test:qa-smoke": "node scripts/qa-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/critical-path.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "monitor": "node scripts/monitor.mjs",
    "monitor:watch": "node scripts/monitor.mjs --watch 30",
    "backup": "node scripts/backup.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.32.0",
    "meilisearch": "^0.60.0",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
